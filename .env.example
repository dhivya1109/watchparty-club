# Copy this file to ".env.local" and fill in your own values after the = signs.
# .env.local is ignored by Git, so your values never get uploaded.

# --- Movie search (server only) ---
# Free key at https://www.themoviedb.org/settings/api
# No "VITE_" prefix on purpose: only the server function (api/movies.ts) can read it,
# so the key never ends up in the website's code. On Vercel: type "Secret".
TMDB_API_KEY=

# --- Shared clubs (Supabase) ---
# Supabase → your project → Copy → "Project URL" and "Publishable key".
# These two ARE meant to be public (the database's security rules protect the data).
# On Vercel: type "Config". Never put the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
